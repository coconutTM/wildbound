diff --git a/shaders/hit_flash.gdshader b/shaders/hit_flash.gdshader
new file mode 100644
index 0000000..2a50bda
--- /dev/null
+++ b/shaders/hit_flash.gdshader
@@ -0,0 +1,11 @@
+shader_type canvas_item;
+
+// ควบคุมจาก GDScript ผ่าน material.set_shader_parameter("flash_amount", x)
+// 0.0 = ปกติ, 1.0 = ขาวเต็มที่
+uniform float flash_amount : hint_range(0.0, 1.0) = 0.0;
+
+void fragment() {
+	vec4 tex_color = texture(TEXTURE, UV);
+	COLOR.rgb = mix(tex_color.rgb, vec3(1.0), flash_amount);
+	COLOR.a = tex_color.a;
+}
